{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "markdown2docx result",
  "oneOf": [
    {
      "type": "object",
      "required": [
        "status",
        "schema_version",
        "conversion_id",
        "output_path",
        "checks",
        "timings",
        "tools",
        "fonts",
        "warnings",
        "preview",
        "language",
        "languages",
        "scripts"
      ],
      "properties": {
        "status": {
          "const": "success"
        },
        "schema_version": {
          "const": "1.0"
        },
        "conversion_id": {
          "type": "string"
        },
        "output_path": {
          "type": "string"
        },
        "language": {
          "type": [
            "string",
            "null"
          ]
        },
        "languages": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "scripts": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "fonts": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "warnings": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "code",
              "message"
            ],
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              }
            }
          }
        },
        "checks": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "timings": {
          "type": "object",
          "additionalProperties": {
            "type": "number",
            "minimum": 0
          }
        },
        "tools": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "preview": {
          "type": "object",
          "required": [
            "status"
          ],
          "properties": {
            "status": {
              "enum": [
                "rendered",
                "unverified",
                "failed"
              ]
            }
          }
        }
      },
      "additionalProperties": true
    },
    {
      "type": "object",
      "required": [
        "status",
        "error"
      ],
      "properties": {
        "status": {
          "const": "error"
        },
        "error": {
          "type": "object",
          "required": [
            "code",
            "message"
          ],
          "properties": {
            "code": {
              "type": "string"
            },
            "message": {
              "type": "string"
            }
          }
        }
      },
      "additionalProperties": true
    }
  ]
}
